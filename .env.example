# ─── Publishing (GitHub) ─────────────────────────────────────────────────────
# The editor publishes by committing to this repository, which makes Vercel
# rebuild. There is no CMS and no storage bill: photos and content both live in
# the repo.
#
# Token: github.com/settings/personal-access-tokens → Fine-grained token,
# scoped to THIS repository only, with "Contents: Read and write". Nothing else.
# Server-only — never prefix it NEXT_PUBLIC_.
GITHUB_TOKEN=
GITHUB_REPO=your-username/hatties-highlights
GITHUB_BRANCH=main

# ─── The editor login (/settings) ────────────────────────────────────────────
# Generate both with:  node scripts/set-password.mjs "a long password"
#
# The hash is colon-separated, not $-separated, on purpose: dotenv expands
# $name, so a $-delimited hash silently arrives mangled and every password is
# rejected while the app appears to boot fine.
#
# Changing EDITOR_SESSION_SECRET signs everyone out immediately — the fastest
# way to revoke access. There is no password reset flow anywhere by design.
EDITOR_PASSWORD_HASH=
EDITOR_SESSION_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Missing in production = the contact form reports a failure rather than
# silently dropping an enquiry.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=hello@hattieshighlights.com

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Optional but strongly recommended in production. Without it the contact form
# falls back to an in-process counter, which does not hold across the many
# short-lived instances Vercel runs — meaning the limit is trivially bypassed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs, sitemap.xml, and
# Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://hattieshighlights.com
